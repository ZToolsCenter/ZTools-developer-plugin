{
  "name": "ztools-developer-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "@xiaou66/u-element-plus": "^0.0.16",
    "@xiaou66/u-styles": "^0.0.14",
    "element-plus": "^2.13.6",
    "pinia": "^3.0.4",
    "pinyin-match": "^1.2.10",
    "unocss": "^66.6.7",
    "vue": "^3.5.30",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@iconify/utils": "^3.1.0",
    "@playwright/test": "^1.58.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.12.0",
    "@unocss/preset-icons": "^66.6.7",
    "@unocss/transformer-directives": "^66.6.7",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vitest/eslint-plugin": "^1.6.10",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "@ztools-center/ztools-api-types": "^1.0.3",
    "code-inspector-plugin": "^1.4.5",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.51.0",
    "eslint-plugin-playwright": "^2.9.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^28.1.0",
    "less": "^4.6.4",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.37.0",
    "oxlint": "~1.51.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^7.3.1",
